---
import { getCollection } from 'astro:content';
import Page from '../components/Page.astro';
import Featured from '../components/Featured.astro';
import RecipeItem from '../components/RecipeItem.astro';
import Wordmark from '../assets/brand/soowee-wordmark.svg';
import '../styles/home.css';

const recipes = (await getCollection('recipes')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'en'));

// One pick at most, so the page always has a single focal point.
const picks = recipes.filter((r) => r.data.featured);
if (picks.length > 1) {
  throw new Error(`Only one recipe can be featured; found ${picks.map((r) => r.id).join(', ')}`);
}
const featured = picks[0];
let listed = 0;

// No photo credits here: Unsplash photos need none, and every item links to its recipe page, whose footer credits
// the photo (CC BY-SA 4.0 allows attribution through a link to the credit, "in any reasonable manner").
---

<Page
  title="soowee"
  description="A personal cookbook, shared with friends and family."
  themeColor={{ light: '#f2f2f7', dark: '#000000' }}
  og={{ type: 'website', title: 'soowee', image: featured?.data.image }}
  skip={{ href: '#all', label: 'Skip to recipes' }}
>
  <main class="home">
    <h1 class="home__title"><Wordmark class="home__wordmark" /></h1>
    <search class="search">
      <label class="sr-only" for="search">Search recipes</label>
      <svg class="icon search__icon" viewBox="0 0 18 18" aria-hidden="true"><circle cx="8" cy="8" r="5.25"></circle><path d="m12 12 3.75 3.75"></path></svg>
      <input
        id="search"
        type="search"
        placeholder="Search recipes"
        enterkeyhint="search"
        autocomplete="off"
        autocapitalize="none"
        spellcheck="false"
      />
      {/* Our own clear button instead of the browser's: same look in every browser, and a 44px target. */}
      <button type="button" class="btn btn--round btn--plain btn--sm search__clear" aria-label="Clear text" data-search-clear hidden>
        <svg viewBox="0 0 18 18" aria-hidden="true"><circle cx="9" cy="9" r="8"></circle><path d="m6.2 6.2 5.6 5.6m0-5.6-5.6 5.6"></path></svg>
      </button>
    </search>

    {featured && <Featured entry={featured} />}

    <section class="all" id="all" aria-labelledby="all-title">
      <div class="all__head">
        <h2 id="all-title" class="all__title">All recipes</h2>
        <p class="all__count" role="status" data-count></p>
      </div>
      <ul class="items">
        {/*
          The featured recipe is in the list too, so search finds it, but hidden until someone searches: a recipe
          never shows twice. Positions skip it, so the first visible row still draws no separator.
        */}
        {recipes.map((entry) => {
          const isFeatured = entry === featured;
          const pos = isFeatured ? -1 : listed++;
          return <RecipeItem entry={entry} eager={!featured && pos < 2} pos={pos} featured={isFeatured} />;
        })}
      </ul>
      <div class="empty" data-empty hidden>
        <p>No recipes match “<span data-empty-query></span>”.</p>
        <button type="button" class="btn btn--capsule btn--fill empty__clear" data-clear>Clear search</button>
      </div>
    </section>
  </main>

  <script>
    import '../scripts/home.ts';
  </script>
</Page>
