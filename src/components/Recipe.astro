---
import { sitePath } from '../lib/url';
import { render, type CollectionEntry } from 'astro:content';
import { Image, Picture } from 'astro:assets';
import Page from './Page.astro';
import '../styles/recipe.css';
import { formatQty, formatScale, formatYield, isoDuration } from '../lib/format';
import { directionTimes, keepAmountsWhole, plainText, renderInline } from '../lib/inline';
import { describeTime, heroTime, readyMinutes } from '../lib/time';
import { backdropFor } from '../lib/backdrop';
import { tintFor } from '../lib/tint';

interface Props {
  entry: CollectionEntry<'recipes'>;
}

const { entry } = Astro.props;
const r = entry.data;
const { Content } = await render(entry);
const tint = await tintFor(r.image, r.tint);
const backdrop = await backdropFor(r.image);
const pageStyle = [
  `--tint:${tint.base}`,
  `--tint-deep:${tint.deep}`,
  backdrop &&
    `--backdrop:url(${backdrop.image});--backdrop-edge:${backdrop.edge};--scrim:${backdrop.scrim};--cook-scrim:${backdrop.cookScrim}`,
  backdrop?.accent && `--accent:${backdrop.accent}`,
]
  .filter(Boolean)
  .join(';');

const SourceTag = r.source?.url ? 'a' : 'div';

const yieldText = formatYield(r.yield.min, r.yield.max, r.yield.unit);
// The hero shows the cooking time, then the wait ("30 min" / "+ 8 hr chilling"); the Directions header says how
// they break down in one generated sentence (lib/time.ts).
// content.config.ts guarantees the hands-off time leaves a positive amount of work.
const times = directionTimes(r.directions);
const time = heroTime(r.time.total, times);
const timeSentence = describeTime(r.time.total, times);

// Each step with the tips that follow it: a tip belongs to the step before it, and the schema makes every section
// start with a step. The page and cook mode both render steps from this.
const sections = r.directions.map((section) => ({
  ...section,
  steps: section.steps.reduce<{ text: string; tips: string[] }[]>((steps, p) => {
    if (typeof p === 'string') steps.push({ text: p, tips: [] });
    else steps.at(-1)!.tips.push(p.tip);
    return steps;
  }, []),
}));

type Ingredient = { qty?: number; unit?: string; name: string; about?: { qty: number; max?: number; unit: string }; note?: string };
/** "g flour" / "onion": the unit (if any) and name, as shown after the quantity. */
const ingredientLabel = (i: Ingredient) => [i.unit, i.name].filter(Boolean).join(' ');
const aboutText = (i: Ingredient) =>
  i.about &&
  `(about ${formatQty(i.about.qty, i.about.unit)}${i.about.max ? `–${formatQty(i.about.max, i.about.unit)}` : ''} ${i.about.unit})`;
const ingredientText = (i: Ingredient) =>
  [
    i.qty !== undefined && formatQty(i.qty, i.unit),
    i.unit,
    i.name + (i.about ? ` ${aboutText(i)}` : '') + (i.note ? `, ${i.note}` : ''),
  ]
    .filter(Boolean)
    .join(' ');

// Absolute URL for JSON-LD needs the production origin (`site`); without it the image is left out.
const imageUrl = Astro.site && new URL(r.image.src, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: r.title,
  description: r.description,
  image: imageUrl,
  recipeCuisine: r.cuisine,
  recipeYield: yieldText.replace(/ /g, ' '), // the no-break space is for layout, not for data
  // schema.org's totalTime means until it can be served, so every wait counts here.
  totalTime: isoDuration(readyMinutes(r.time.total, times)),
  recipeIngredient: r.ingredients.flatMap((g) => g.items.map(ingredientText)),
  recipeInstructions: r.directions.map((s) => ({
    '@type': 'HowToSection',
    name: s.title,
    itemListElement: [s.heat, ...s.steps]
      .filter((p): p is string => typeof p === 'string')
      .map((p) => ({ '@type': 'HowToStep', text: plainText(p) })),
  })),
};

const icons = {
  cook: 'M3.6 8.200h10.800v4.300a2.700 2.700 0 0 1-2.700 2.700H6.300a2.700 2.700 0 0 1-2.700-2.700V8.200ZM1.800 8.200h14.400M6.200 5.400h5.600M9 5.400V3.200',
  save: 'M5 2.8h8a.8.8 0 0 1 .8.8v11.600L9 12.200l-4.800 3V3.600a.8.8 0 0 1 .8-.8Z',
  share: 'M9 11V2.400M6 5l3-3 3 3M5.600 8H4.400a.9.9 0 0 0-.9.900v5.700c0 .5.400.9.900.9h9.200c.5 0 .9-.4.900-.9V8.900a.9.9 0 0 0-.9-.9h-1.200',
  chevron: 'm7 3.500 5 5.500-5 5.500',
  // Spans x 6.25–11.75, centred in the 18 box (drawn at 5.5–11 it sat 0.75 left of centre in the round button).
  back: 'M11.750 3.500 6.250 9l5.500 5.500',
  close: 'm4.500 4.500 9 9m0-9-9 9',
  check: 'm3.500 9.500 3.500 3.500 7.500-8',
  minus: 'M4 9h10',
  plus: 'M4 9h10M9 4v10',
  heat: 'M9 2.200a1.800 1.800 0 0 0-1.800 1.800v6.200a3.300 3.300 0 1 0 3.600 0V4A1.800 1.800 0 0 0 9 2.200ZM9 7.200v5.600',
  bulb: 'M9 1.800a5 5 0 0 0-3 9c.5.400.800 1 .800 1.600v.4h4.400v-.4c0-.6.300-1.200.800-1.600a5 5 0 0 0-3-9ZM7.200 15.600h3.600',
  pause: 'M6.500 4.5v9M11.5 4.5v9',
  play: 'M6.300 4.300 13.200 9 6.300 13.700Z',
};
---

<Page
  title={`${r.title} · soowee`}
  description={r.description}
  themeColor={backdrop?.edge ?? tint.base}
  bodyStyle={pageStyle}
  og={{ type: 'article', title: r.title, image: r.image }}
  skip={{ href: '#recipe', label: 'Skip to recipe' }}
>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

    <main>
      <article
        data-recipe={entry.id}
        data-yield-min={r.yield.min}
        data-yield-max={r.yield.max}
        data-yield-unit={r.yield.unit}
      >
        <header class="hero">
          <a class="btn btn--round btn--scrim back" href={sitePath('/')} aria-label="All recipes">
            <svg class="icon" viewBox="0 0 18 18" aria-hidden="true"><path d={icons.back} /></svg>
          </a>
          <!-- The photo continues past its edge as a mirrored, blurred copy (background extension). -->
          <div class="hero__backdrop" aria-hidden="true">
            <div></div>
            <div class="is-mirror"></div>
          </div>
          <div class="hero__media">
            <Picture
              src={r.image}
              alt={r.imageAlt}
              formats={['avif', 'webp']}
              widths={[480, 768, 1080, 1440, 1920, 2560]}
              sizes="(min-width: 100rem) calc(50vw + 8rem), (min-width: 48rem) 58vw, 100vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>

          <div class="hero__body">
            {r.cuisine && <p class="eyebrow">{r.cuisine}</p>}
            <h1>{r.title}</h1>
            {r.byline && <p class="byline">{r.byline}</p>}

            {/*
              Two facts only, so the row stays on one line on phones. Time is the cooking time with the wait on a
              line of its own under it, so the cell never gets wider than its longer line; the breakdown is the
              sentence under Directions.
            */}
            <dl class="meta">
              <div>
                <dt>Time</dt>
                <dd>
                  {time.cook}
                  {time.wait && <span class="meta__wait">+ {time.wait}</span>}
                </dd>
              </div>
              <div>
                <dt>Yield</dt>
                <dd data-yield>{yieldText}</dd>
              </div>
            </dl>

            {
              r.source && (
                <SourceTag class="story" href={r.source.url} rel={r.source.url && 'noopener'}>
                  <Image src={r.image} alt="" width={88} height={88} fit="cover" loading="eager" />
                  <span class="story__text">
                    <span class="story__label">{r.source.label}</span>
                    <span class="story__title">{r.source.title}</span>
                  </span>
                  {r.source.url && (
                    <svg class="icon" viewBox="0 0 18 18" aria-hidden="true">
                      <path d={icons.chevron} />
                    </svg>
                  )}
                </SourceTag>
              )
            }

            <div class="actions">
              <button type="button" class="btn btn--capsule btn--glass action" data-cook-open aria-haspopup="dialog">
                <svg class="icon" viewBox="0 0 18 18" aria-hidden="true"><path d={icons.cook} /></svg>
                Cook
              </button>
              <button type="button" class="btn btn--capsule btn--glass action" data-save>
                <svg class="icon" viewBox="0 0 18 18" aria-hidden="true"><path d={icons.save} /></svg>
                <span data-save-label>Save</span>
              </button>
              <button type="button" class="btn btn--capsule btn--glass action" data-share>
                <svg class="icon" viewBox="0 0 18 18" aria-hidden="true"><path d={icons.share} /></svg>
                Share
              </button>
            </div>

            <p class="lede">{r.description}</p>
          </div>
        </header>

        <div class="sheet" id="recipe">
          <div>
            <section class="ingredients" aria-labelledby="ingredients-title">
              <div class="section-head">
                <div>
                  <h2 class="section-title" id="ingredients-title">Ingredients</h2>
                  <p class="section-sub">Yields <span data-yield>{yieldText}</span></p>
                </div>
                <div class="scale" role="group" aria-label="Scale recipe">
                  <button type="button" class="btn btn--round btn--plain" data-scale="-1" aria-label="Scale down">
                    <svg class="icon" viewBox="0 0 18 18" aria-hidden="true"><path d={icons.minus} /></svg>
                  </button>
                  <output data-scale-output aria-live="polite">{formatScale(1)}</output>
                  <button type="button" class="btn btn--round btn--plain" data-scale="1" aria-label="Scale up">
                    <svg class="icon" viewBox="0 0 18 18" aria-hidden="true"><path d={icons.plus} /></svg>
                  </button>
                </div>
              </div>

              {
                r.ingredients.map((group) => (
                  <>
                    {group.group && <h3 class="group-label">{group.group}</h3>}
                    <ul>
                      {group.items.map((item) => (
                        <li>
                          <label class="ingredient">
                            <input type="checkbox" />
                            <span class="ingredient__qty" data-qty={item.qty} data-unit={item.unit}>
                              {item.qty !== undefined && formatQty(item.qty, item.unit)}
                            </span>
                            <span>
                              {ingredientLabel(item)}
                              {item.about && (
                                <span class="ingredient__note">
                                  {' (about '}
                                  <span data-qty={item.about.qty} data-unit={item.about.unit}>
                                    {formatQty(item.about.qty, item.about.unit)}
                                  </span>
                                  {item.about.max && '–'}
                                  {item.about.max && (
                                    <span data-qty={item.about.max} data-unit={item.about.unit}>
                                      {formatQty(item.about.max, item.about.unit)}
                                    </span>
                                  )}
                                  {`\u00a0${item.about.unit})`}
                                </span>
                              )}
                              {item.note && <span class="ingredient__note">, {keepAmountsWhole(item.note)}</span>}
                            </span>
                            <svg class="icon" viewBox="0 0 18 18" aria-hidden="true">
                              <path d={icons.check} />
                            </svg>
                          </label>
                        </li>
                      ))}
                    </ul>
                  </>
                ))
              }
            </section>

            {
              r.equipment.length > 0 && (
                <section class="equipment" aria-labelledby="equipment-title">
                  <div class="section-head">
                    <h2 class="section-title" id="equipment-title">
                      Equipment
                    </h2>
                  </div>
                  <ul>
                    {r.equipment.map((item) => (
                      <li>{keepAmountsWhole(item)}</li>
                    ))}
                  </ul>
                </section>
              )
            }
          </div>

          <div>
            <section class="directions" aria-labelledby="directions-title">
              <div class="section-head">
                <div>
                  <h2 class="section-title" id="directions-title">Directions</h2>
                  <p class="section-sub section-sub--time">
                    {timeSentence.map((s) => (s.strong ? <strong>{keepAmountsWhole(s.text)}</strong> : keepAmountsWhole(s.text)))}
                  </p>
                </div>
              </div>

              <ol class="directions__sections" role="list">
                {
                  sections.map((section) => (
                    <li class="directions__section" data-section={section.title}>
                      <h3 class="directions__title">{section.title}</h3>
                      {section.heat && (
                        <p class="heat">
                          <svg class="icon" viewBox="0 0 18 18" aria-hidden="true">
                            <path d={icons.heat} />
                          </svg>
                          <span set:html={renderInline(section.heat)} />
                        </p>
                      )}
                      <ol class="directions__steps" role="list">
                        {section.steps.map((step) => (
                          <li>
                            <p set:html={renderInline(step.text)} />
                            {step.tips.map((tip) => (
                              <p class="tip">
                                <svg class="icon" viewBox="0 0 18 18" aria-hidden="true">
                                  <path d={icons.bulb} />
                                </svg>
                                <span>
                                  <span class="sr-only">Tip: </span>
                                  <Fragment set:html={renderInline(tip)} />
                                </span>
                              </p>
                            ))}
                          </li>
                        ))}
                      </ol>
                    </li>
                  ))
                }
              </ol>
            </section>

            {
              entry.body?.trim() && (
                <section class="prose" aria-label="Notes">
                  <Content />
                </section>
              )
            }
          </div>
        </div>
      </article>
    </main>

    {
      r.imageCredit && (
        <p slot="credits">
          Photo: <a href={r.imageCredit.url}>{r.imageCredit.author}</a>, {r.imageCredit.license}
        </p>
      )
    }
    <Fragment slot="after-footer">

    <dialog class="cook" id="cook" aria-labelledby="cook-title">
      <div class="cook__head">
        <Image src={r.image} alt="" width={96} height={96} fit="cover" loading="eager" />
        <p class="cook__title" id="cook-title" tabindex="-1">
          {r.title}
          <span>soowee</span>
        </p>
        <button type="button" class="btn btn--round btn--scrim cook__close" data-cook-close aria-label="Close cook mode">
          <svg class="icon" viewBox="0 0 18 18" aria-hidden="true"><path d={icons.close} /></svg>
        </button>
      </div>

      <div class="segmented segmented--glass cook__tabs" role="tablist" aria-label="Cook mode view">
        <button
          type="button"
          class="segmented__item"
          data-label="Ingredients"
          role="tab"
          id="tab-ingredients"
          aria-controls="panel-ingredients"
          aria-selected="false"
          tabindex="-1">Ingredients</button
        >
        <button type="button" class="segmented__item" data-label="Directions" role="tab" id="tab-directions" aria-controls="panel-directions" aria-selected="true"
          >Directions</button
        >
      </div>

      <div class="cook__panel" id="panel-ingredients" role="tabpanel" aria-labelledby="tab-ingredients" tabindex="0" hidden>
        <div class="cook__inner">
        <p class="cook__yield">
          Yields <span data-yield>{yieldText}</span>
        </p>
        {
          r.ingredients.map((group) => (
            <>
              {group.group && <h3 class="cook__group">{group.group}</h3>}
              <ul>
                {group.items.map((item) => (
                  <li class="cook__ingredient">
                    <b data-qty={item.qty} data-unit={item.unit}>
                      {item.qty !== undefined && formatQty(item.qty, item.unit)}
                    </b>
                    <span>
                      {ingredientLabel(item)}
                      {item.about && (
                        <span class="ingredient__note">
                          {' (about '}
                          <span data-qty={item.about.qty} data-unit={item.about.unit}>
                            {formatQty(item.about.qty, item.about.unit)}
                          </span>
                          {item.about.max && '–'}
                          {item.about.max && (
                            <span data-qty={item.about.max} data-unit={item.about.unit}>
                              {formatQty(item.about.max, item.about.unit)}
                            </span>
                          )}
                          {`\u00a0${item.about.unit})`}
                        </span>
                      )}
                      {item.note && <span class="ingredient__note">, {keepAmountsWhole(item.note)}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </>
          ))
        }
        </div>
      </div>

      <!-- The section being cooked, outside the scrolling text so it stays in view. Visual only: the headings in the
           panel carry the structure for screen readers, and the active step has aria-current. -->
      <p class="cook__context" aria-hidden="true" data-cook-context>
        <span data-context-title>{sections[0].title}</span>{' '}
        <span class="cook__count" data-context-count>1 of {sections.length}</span>
      </p>

      <div class="cook__panel" id="panel-directions" role="tabpanel" aria-labelledby="tab-directions" tabindex="0">
        <div class="cook__inner">
        {
          sections.map((section, i) => (
            <div class="cook__section" data-section={section.title} data-count={`${i + 1} of ${sections.length}`}>
              <h3 class="sr-only">{section.title}</h3>
              {section.heat && <p class="cook__step" data-step set:html={renderInline(section.heat)} />}
              {section.steps.map((step) => (
                <div class="cook__step" data-step>
                  <p set:html={renderInline(step.text)} />
                  {step.tips.map((tip) => (
                    <p class="cook__tip" set:html={`Tip: ${renderInline(tip)}`} />
                  ))}
                </div>
              ))}
            </div>
          ))
        }
        </div>
      </div>
    </dialog>

    <div class="hud">
      <p class="toast" role="status" data-toast></p>
      <div class="timers" role="region" aria-label="Timers" data-timers></div>
    </div>

    <script>
      import '../scripts/recipe.ts';
    </script>
    </Fragment>
</Page>
