---
import { sitePath } from '../lib/url';
/**
 * The shell every page shares: <head>, skip link, footer (the onion, photo credits, appearance switch).
 * Pages put their content in the default slot, extra <head> tags (JSON-LD) in `head`, and their photo credits
 * in `credits`.
 */
import '../styles/global.css';
import Logo from './Logo.astro';
import { localeOf, otherLocale, strings } from '../lib/i18n';

interface Props {
  /** Full document title. */
  title: string;
  description: string;
  /** Browser UI colour: one value, or one per colour scheme. */
  themeColor: string | { light: string; dark: string };
  /** Custom properties for the page (per-recipe tint and backdrop). */
  bodyStyle?: string;
  og: { type: 'website' | 'article'; title: string; image?: ImageMetadata };
  skip: { href: string; label: string };
  /** This page in the other language, from localePath(): every page exists in both. */
  translation: string;
}

const { title, description, themeColor, bodyStyle, og, skip, translation } = Astro.props;
const locale = localeOf(Astro.currentLocale);
const other = otherLocale(locale);
const t = strings(locale);

// Absolute URLs need the production origin (`site`); without it they are left out instead of pointing at localhost.
const origin = Astro.site;
const canonical = origin && new URL(Astro.url.pathname, origin).href;
const imageUrl = origin && og.image && new URL(og.image.src, origin).href;
// hreflang needs absolute URLs, like canonical.
const alternate = origin && new URL(translation, origin).href;
const OG_LOCALE = { cs: 'cs_CZ', en: 'en_GB' } as const;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      typeof themeColor === 'string' ? (
        <meta name="theme-color" content={themeColor} />
      ) : (
        <>
          {/* data-scheme lets the appearance switch pin one of them when it overrides the system (theme.ts). */}
          <meta name="theme-color" content={themeColor.light} media="(prefers-color-scheme: light)" data-scheme="light" />
          <meta name="theme-color" content={themeColor.dark} media="(prefers-color-scheme: dark)" data-scheme="dark" />
        </>
      )
    }
    <link rel="icon" href={sitePath('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={sitePath('/apple-touch-icon.png')} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && alternate && <link rel="alternate" hreflang={locale} href={canonical} />}
    {alternate && <link rel="alternate" hreflang={other} href={alternate} />}
    <meta property="og:type" content={og.type} />
    <meta property="og:site_name" content="soowee" />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    <meta property="og:title" content={og.title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <script is:inline>
      try {
        const theme = localStorage.getItem('soowee:theme');
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme;
          // Same as applyThemeColor() in theme.ts: the browser bar follows the chosen theme, not the system.
          for (const meta of document.querySelectorAll('meta[name="theme-color"][data-scheme]')) {
            meta.media = meta.dataset.scheme === theme ? 'all' : 'not all';
          }
        }
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body style={bodyStyle}>
    <a class="skip" href={skip.href}>{skip.label}</a>

    <slot />

    <footer class="footer">
      <Logo class="footer__logo" quiet />
      <slot name="credits" />
      <a class="footer__language" href={translation} hreflang={other} lang={other}>{t.switchTo}</a>
      <fieldset class="segmented theme">
        <legend class="sr-only">{t.appearance}</legend>
        {
          (
            [
              ['light', t.themeLight],
              ['dark', t.themeDark],
              ['auto', t.themeAuto],
            ] as const
          ).map(([value, label]) => (
            <label>
              <input type="radio" name="theme" value={value} checked={value === 'auto'} />
              <span class="segmented__item" data-label={label}>{label}</span>
            </label>
          ))
        }
      </fieldset>
    </footer>
    <slot name="after-footer" />
    <script>
      import '../scripts/theme.ts';
    </script>
  </body>
</html>
